            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Test Suite (test_system.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/test_system.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
