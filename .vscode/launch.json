{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Website (website/app.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/website/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/website",
            "justMyCode": true
        },
        {
            "name": "Run CLI Program (main.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
